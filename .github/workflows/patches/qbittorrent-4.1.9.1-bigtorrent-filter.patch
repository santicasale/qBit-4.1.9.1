+void AddNewTorrentDialog::filterContent(const QString &filter)
+{
+    if (!m_contentModel) return;
+
+    m_contentModel->setFilterRegExp(QRegExp(filter, Qt::CaseInsensitive, QRegExp::WildcardUnix));
+    if (filter.isEmpty()) {
+        m_ui->contentTreeView->collapseAll();
+        m_ui->contentTreeView->expand(m_contentModel->index(0, 0));
+    }
+    else {
+        m_ui->contentTreeView->expandAll();
+    }
